# Serve all API calls from the in-browser mock backend (seeded demo data).
# Set to "false" to talk to the NestJS API below.
NEXT_PUBLIC_USE_MOCK_API=true

# NestJS REST API base URL (PRD §08). Refresh tokens are httpOnly cookies on this domain,
# so the API must allow credentials from the frontend origin (strict CORS allow-list).
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Socket.IO server for real-time notifications.
NEXT_PUBLIC_WS_URL=http://localhost:3001
